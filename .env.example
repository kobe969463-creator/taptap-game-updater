# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实密钥

# ===== 模型（OpenAI 兼容接口），默认千问 qwen3.8-flash（阿里云百炼；有专属接入地址就填专属地址）=====
API_KEY=sk-xxxxxxxxxxxxxxxx
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.8-flash
# 纯 JSON，直接透传到请求体
EXTRA_BODY={"enable_thinking": true}
MAX_TOKENS=3000
TEMPERATURE=0
TOP_P=0.85
# autoglm 的 ModelConfig 支持时才生效
IMAGE_DETAIL=original

# ===== autoglm 仓库路径（phone_agent 从这里导入），默认与本仓库同级的 ../autoglm =====
AUTOGLM_PATH=../autoglm
